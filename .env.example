# 复制为 .env 后填写；.env 不会进版本库
UPSTREAM_URL=http://192.168.2.8:8021
LISTEN_PORT=8022
DB_PATH=data/progress.db
LOG_LEVEL=INFO
TZ=Asia/Shanghai
PLAYED_THRESHOLD=0.9

# 原生进度写入：off / local（容器挂载库文件）/ ssh（开发机远程，仅调试用）
NATIVE_MODE=local
# 容器里是 /zvideo/zvideo.db；开发机 SSH 模式填 /zspace/zsrp/sqlite/zvideo/zvideo.db
NATIVE_DB_PATH=/zvideo/zvideo.db
# 极空间账号（zvideo 库里的 user_name），必填
NATIVE_USER=
# 两次写库的最小间隔（秒），Stopped 上报不受限制
NATIVE_MIN_INTERVAL=10
# 本地记录宽限期（秒）：超过这个时间且极影视没有记录，就认为那边删了
SYNC_GRACE_SECONDS=15
# 是否把客户端的音轨/字幕选择写回极影视
SYNC_STREAM_PREFS=true
# 预置控制台密码（至少 6 位）；留空则首次打开 /admin 时设置
ADMIN_PASSWORD=

# 仅 NATIVE_MODE=ssh 时需要（开发期临时通道）
ZSPACE_SSH_HOST=
ZSPACE_SSH_PORT=22
ZSPACE_SSH_USER=
ZSPACE_PASS=
